MUSICBRAINZ_USERAGENT=      #AppName/1.1.1 (github.com/YourUsername)

SLSKD_URL=                  #http://slskd:5030
SLSKD_APIKEY=               #ApiKey1234_here

# where slskd puts completed downloads, as seen from inside THIS container.
# must point at the same files slskd writes to (mount the same volume).
SLSKD_DOWNLOAD_PATH=        #/downloads

# where organized music gets filed to
LIBRARY_PATH=               #/music

# where the jimbrainz database lives, needs to be on a persistent volume
DB_PATH=                    #/config/jimbrainz.db
