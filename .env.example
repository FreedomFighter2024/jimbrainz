# Copy this to .env and fill in the values.
#
# Everything here can ALSO be set in your compose file's `environment:` block instead, and a
# value there wins over the same name here. Use whichever suits you - .env keeps your slskd API
# key out of a file you might paste into a forum post, while `environment:` keeps everything
# about the container in one place. Mixing them is fine and jimbrainz logs which source each
# setting came from on startup.
#
# One thing not to do: `SLSKD_URL=${SLSKD_URL}` in `environment:`. Compose interpolates that
# from its own environment, and an empty result still counts as set - so it beats this file and
# leaves the setting blank while the line below looks perfectly correct. Write literal values
# there. See docker-compose.example.yml.
#
# Keep the examples on their own lines like this rather than trailing the value
# (SLSKD_URL=   #http://...). Docker Compose and python-dotenv disagree about inline
# comments, and a blank value with a trailing comment is a good way to end up with an
# empty setting and a confusing error.

# Run as this user/group rather than root. Match these to slskd and your other *arr
# containers so everything writes files with consistent ownership - `id yourname` on the
# host prints the values you want. Files the organizer creates will be owned by this user.
PUID=1000
PGID=1000

# AppName/1.1.1 (github.com/YourUsername)
MUSICBRAINZ_USERAGENT=

# full URL including the scheme - http://slskd:5030, NOT slskd:5030
SLSKD_URL=

SLSKD_APIKEY=

# off      - never organize, downloads just stay in slskd's folder
# dry_run  - log what would happen, touch nothing  (DEFAULT)
# copy     - copy into the library, leave slskd's copy alone
# move     - move into the library
#
# starts at dry_run on purpose: organizing is the only thing here that writes to your
# filesystem, so check the event log looks right before switching to copy or move.
ORGANIZE_MODE=dry_run

# The three below are set for you in docker-compose.example.yml and match the volume
# mounts there - you only need them if you're running outside of that compose file.
#
# where slskd puts completed downloads, as seen from inside THIS container. Must point at
# the same files slskd writes to.
#SLSKD_DOWNLOAD_PATH=/downloads
#
# where organized music gets filed to
#LIBRARY_PATH=/music
#
# slskd's INCOMPLETE folder, as seen from inside this container. Optional, and cleanup is off
# without it: set it and cancelling a download also removes the half-finished file, leave it
# and that file stays. slskd keeps partials on purpose - with retry.partial set to Resume it
# picks a retried download up from where the partial ended instead of starting again - so only
# set this if a cancelled download is one you're finished with.
#SLSKD_INCOMPLETE_PATH=/incomplete
#
# where the database lives, needs to be on a persistent volume
#DB_PATH=/config/jimbrainz.db
