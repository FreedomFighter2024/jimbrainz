# Copy this to .env and fill in the values.
#
# Keep the examples on their own lines like this rather than trailing the value
# (SLSKD_URL=   #http://...). Docker Compose and python-dotenv disagree about inline
# comments, and a blank value with a trailing comment is a good way to end up with an
# empty setting and a confusing error.

# AppName/1.1.1 (github.com/YourUsername)
MUSICBRAINZ_USERAGENT=

# full URL including the scheme - http://slskd:5030, NOT slskd:5030
SLSKD_URL=

SLSKD_APIKEY=

# off      - never organize, downloads just stay in slskd's folder
# dry_run  - log what would happen, touch nothing  (DEFAULT)
# copy     - copy into the library, leave slskd's copy alone
# move     - move into the library
#
# starts at dry_run on purpose: organizing is the only thing here that writes to your
# filesystem, so check the event log looks right before switching to copy or move.
ORGANIZE_MODE=dry_run

# The three below are set for you in docker-compose.example.yml and match the volume
# mounts there - you only need them if you're running outside of that compose file.
#
# where slskd puts completed downloads, as seen from inside THIS container. Must point at
# the same files slskd writes to.
#SLSKD_DOWNLOAD_PATH=/downloads
#
# where organized music gets filed to
#LIBRARY_PATH=/music
#
# where the database lives, needs to be on a persistent volume
#DB_PATH=/config/jimbrainz.db
